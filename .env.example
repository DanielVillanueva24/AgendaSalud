# Plantilla de variables de entorno de AgendaSalud.
#
# Este archivo SI se versiona: solo contiene los nombres de las variables y una
# descripcion, nunca valores reales.
#
# Para trabajar en local: copialo a `.env` y rellena lo que necesites.
# `.env` esta en .gitignore y no debe subirse nunca a GitHub.
# En Render los valores se cargan en Dashboard > el servicio > Environment.

# --- Base de datos ------------------------------------------------------------
# Cadena de conexion de PostgreSQL. Si se deja vacia, la aplicacion usa la base
# SQLite local (agendasalud.db en la raiz del proyecto).
# Formato: postgresql://USUARIO:CONTRASENA@HOST:5432/BASE
# OJO: esta cadena incluye la contrasena de la base. No la pegues en el codigo,
# ni en el README, ni en un commit, ni en un chat.
DATABASE_URL=

# --- Sesiones -----------------------------------------------------------------
# Clave con la que se firman las cookies de sesion. Obligatoria en produccion.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Correo ------------------------------------------------------------------
# Hay dos vias de envio y se usa la primera que este configurada. Sin ninguna,
# la aplicacion funciona igual y los correos se escriben en el log (simulado).
#
# VIA 1 - Brevo sobre HTTPS. Es la que hay que usar en la nube: los planes
# gratuitos de Render y similares bloquean las conexiones salientes a los
# puertos de SMTP, y Gmail falla con "Network is unreachable" aunque las
# credenciales sean correctas. Requiere MAIL_DEFAULT_SENDER.
BREVO_API_KEY=
# Remitente que ve el paciente. Con Brevo tiene que ser una direccion verificada
# en la cuenta (Senders, Domains & Dedicated IPs > Senders).
MAIL_DEFAULT_SENDER=
# Nombre visible del remitente (por defecto: AgendaSalud)
MAIL_SENDER_NAME=

# VIA 2 - SMTP de Gmail. Sirve en local.
MAIL_USERNAME=
# Contrasena de aplicacion de Gmail (16 caracteres, sin espacios). Requiere
# verificacion en dos pasos. NO es la contrasena normal de la cuenta.
MAIL_PASSWORD=

# --- Recordatorio diario (opcional) -------------------------------------------
# Hora de la tarea que avisa de las citas del dia siguiente (18:00 por defecto)
RECORDATORIO_HORA=18
RECORDATORIO_MINUTO=0
# Poner en 0 para desactivar la tarea programada
RECORDATORIOS_ACTIVOS=1
