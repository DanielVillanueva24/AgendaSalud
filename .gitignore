# Secretos: variables de entorno, credenciales y certificados.
# NUNCA se versionan. La plantilla sin valores es .env.example
.env
.env.*
!.env.example
*.env
secrets.json
credenciales*.json
*.pem
*.key

# Base de datos SQLite: contiene datos de pacientes y hashes de contrasenas
# (se regenera con seed.py)
*.db
*.db-journal
*.sqlite3

# Entorno virtual de Python
Back/venv/
venv/
env/
.venv/

# Bytecode y cachés de Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Entregables y paquetes de entrega: son documentos del curso, no codigo
*.zip
EntregablesDocx/

# Archivos temporales de Office
~$*.docx
~$*.xlsx
~$*.pptx

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Editores y herramientas locales
.vscode/
.idea/
*.swp

# Registros
*.log
